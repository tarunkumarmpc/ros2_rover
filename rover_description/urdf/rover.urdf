<?xml version="1.0"?>
<robot name="rover">

  <!-- Baselink -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.61 0.322 0.05"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <!-- Front Left Wheel -->
  <link name="front_left_wheel">
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Front Right Wheel -->
  <link name="front_right_wheel">
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Rear Left Wheel -->
  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Rear Right Wheel -->
  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Define materials once -->
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <!-- Joints -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.305 0.161 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.305 -0.161 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.305 0.161 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.305 -0.161 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Camera Lift System -->
  <link name="camera_lift_mast">
    <visual>
      <geometry>
        <cylinder length="0.3" radius="0.01"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>
  <joint name="camera_lift_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_lift_mast"/>
    <origin xyz="0.25 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="camera_lift_link">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="camera_lift_joint" type="prismatic">
    <parent link="camera_lift_mast"/>
    <child link="camera_lift_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.15" upper="0.15" effort="100" velocity="0.5"/>
  </joint>

  <!-- Rover Lift System -->
  <link name="rover_lift_base">
    <visual>
      <geometry>
        <box size="0.2 0.2 0.1"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>
  <joint name="rover_lift_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rover_lift_base"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
  </joint>

  <link name="rover_lift_link">
    <visual>
      <geometry>
        <box size="0.3 0.3 0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="rover_lift_joint" type="prismatic">
    <parent link="rover_lift_base"/>
    <child link="rover_lift_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.2" effort="500" velocity="0.2"/>
  </joint>

  <!-- Parcel (for visual effect) -->
  <link name="parcel_link">
    <visual>
      <geometry>
        <box size="0.15 0.15 0.15"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1"/>
      </material>
    </visual>
  </link>
  <joint name="parcel_joint" type="fixed">
    <parent link="rover_lift_link"/>
    <child link="parcel_link"/>
    <origin xyz="0 0 0.085" rpy="0 0 0"/>
  </joint>

</robot>
